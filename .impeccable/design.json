  "narrative": {
    "northStar": "The Terminal Atelier",
    "overview": "An engineer's monospace discipline in a studio's soft, gradient-washed room. Headings, labels and buttons are set in JetBrains Mono, which keeps the page technical and honest, while body text is IBM Plex Sans for comfortable reading; pastel gradients, translucent glass and rounded corners keep it approachable rather than austere. The chronological Journey timeline borrows the language of a git commit log, so the page reads as a record of work.\n\nThe system is calm and spacious: wide section padding, a single 1200px column, one accent hue. Light mode is a clean off-white canvas; dark mode is deep indigo and plum with a glowing frosted-blue accent. Both themes are first-class and the user can switch.",
    "keyCharacteristics": [
      "Two families: JetBrains Mono for headings, labels and tags; IBM Plex Sans for running text.",
      "One accent hue, frosted blue, shifted per theme for contrast.",
      "Tonal gradient backdrops that change from section to section.",
      "Soft, rounded, glassy components; glow only in dark mode.",
      "Git-flavored timeline motifs in Journey."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "The frosted blue is the only chromatic accent. The one exception is the Journey timeline, whose org (orange) and award (amber) tracks are data categories, each also coded by line style; light-mode values are darkened to clear 3:1. Do not add any other hue.",
        "section": "colors"
      },
      {
        "name": "The Dark Band Rule",
        "body": "On the always-dark section (.accent-on-dark), use the light accent #b1e5f2 in every theme; the light-theme accent is only about 2:1 against it.",
        "section": "colors"
      },
      {
        "name": "The Caps Label Rule",
        "body": "Uppercase tracked text is reserved for the 12px label style (buttons, tags); never for body or headlines.",
        "section": "typography"
      },
      {
        "name": "The Dark-Only Glow Rule",
        "body": "Glow appears only in dark mode; light mode stays flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the type tokens rather than raw sizes or font names.",
      "Do use one accent hue per theme (#1b6375 light, #b1e5f2 dark).",
      "Do keep every tap target at least 44px (.tap-44).",
      "Do respect prefers-reduced-motion; all transitions collapse.",
      "Do keep light mode flat and reserve glow for dark mode."
    ],
    "donts": [
      "Don't add a second accent colour outside the Journey track hues.",
      "Don't use accent #1b6375 on the always-dark section; use #b1e5f2.",
      "Don't put shadows on resting elements.",
      "Don't hide content by default behind scroll reveals; content must be visible without JavaScript or reduced-motion preference."
    ]
  }
